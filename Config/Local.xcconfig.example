// Copy this file to Local.xcconfig and provide values for your own account.

DEVICE_HUB_BUNDLE_IDENTIFIER = com.example.DeviceHub
DEVICE_HUB_DEVELOPMENT_TEAM =
DEVICE_HUB_CODE_SIGN_STYLE = Automatic
DEVICE_HUB_PROVISIONING_PROFILE_SPECIFIER =
DEVICE_HUB_PAIRING_KEYCHAIN_SERVICE = DeviceHub.PairingVault

// Optional remote diagnostics remain disabled until the user opts in in-app.
// DEVICE_HUB_DIAGNOSTICS_ENDPOINT = https://diagnostics.example/v1/diagnostics/batches
// DEVICE_HUB_DIAGNOSTICS_TOKEN =

// Optional agent HTTP API (port 8765). Off unless a token of at least 16
// characters is set; requests must come from loopback or Tailscale and send
// "Authorization: Bearer <token>". Generate one with: openssl rand -hex 24
// DEVICE_HUB_AGENT_TOKEN =
